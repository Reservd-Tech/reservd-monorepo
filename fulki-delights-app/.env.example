# Browser-safe credentials from Supabase Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only signing secret for the verified-location cookie; generate a long random value.
OTP_SIGNING_SECRET=

# Enable email OTP and SMS OTP in Supabase Auth. Configure the email template to show
# {{ .Token }} and store provider credentials in Supabase Auth settings, not VITE_* variables.
# For SMS WebOTP, end the SMS template with the app's origin-bound suffix:
# @your-domain #{{ .Code }}
