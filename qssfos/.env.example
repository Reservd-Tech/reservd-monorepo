# Browser-visible Supabase project settings only. These values identify the project;
# use the project's public anon/publishable key, never a service-role or secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Configure Email/SMS auth providers, SMTP/API credentials, and message templates
# in Supabase Dashboard > Authentication. Do not put provider credentials or any
# other secrets in VITE_* variables; VITE_* values are exposed to the browser.
#
# For SMS WebOTP autofill, append this origin-bound suffix to the Supabase SMS
# template, replacing your-domain with the app's host (no scheme or path):
# @your-domain #{{ .Code }}
